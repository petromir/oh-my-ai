      "command(*.jks*)",
      "command(*.key*)",
      "command(*.p12*)",
      "command(*.pem*)",
      "command(*/.aws/*)",
      "command(*/.azure/*)",
      "command(*/.config/gcloud/*)",
      "command(*/.docker/*)",
      "command(*/.gnupg/*)",
      "command(*/.kube/*)",
      "command(*/.ssh/*)",
      "command(~/.aws/*)",
      "command(~/.azure/*)",
      "command(~/.config/gcloud/*)",
      "command(~/.docker/*)",
      "command(~/.gnupg/*)",
      "command(~/.kube/*)",
      "command(~/.ssh/*)",
      "read_file(*credentials*)",
      "read_file(*.jks)",
      "read_file(*.key)",
      "read_file(*.p12)",
      "read_file(*.pem)",
      "read_file(*/.aws/*)",
      "read_file(*/.azure/*)",
      "read_file(*/.config/gcloud/*)",
      "read_file(*/.docker/*)",
      "read_file(*/.gnupg/*)",
      "read_file(*/.kube/*)",
      "read_file(*/.ssh/*)",
      "read_file(~/.aws/*)",
      "read_file(~/.azure/*)",
      "read_file(~/.config/gcloud/*)",
      "read_file(~/.docker/*)",
      "read_file(~/.gnupg/*)",
      "read_file(~/.kube/*)",
      "read_file(~/.ssh/*)",
      "write_file(*credentials*)",
      "write_file(*.jks)",
      "write_file(*.key)",
      "write_file(*.p12)",
      "write_file(*.pem)",
      "write_file(*/.aws/*)",
      "write_file(*/.azure/*)",
      "write_file(*/.config/gcloud/*)",
      "write_file(*/.docker/*)",
      "write_file(*/.gnupg/*)",
      "write_file(*/.kube/*)",
      "write_file(*/.ssh/*)",
      "write_file(~/.aws/*)",
      "write_file(~/.azure/*)",
      "write_file(~/.config/gcloud/*)",
      "write_file(~/.docker/*)",
      "write_file(~/.gnupg/*)",
      "write_file(~/.kube/*)",
      "write_file(~/.ssh/*)"
