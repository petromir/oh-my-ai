      "command(scp *)",
      "command(shutdown*)",
      "command(ssh *)",
      "command(sudo chown *)",
      "command(sudo rm *)",
      "command(wget *)",
      "read_file(*.env*)",
      "read_file(.env*)",
      "read_file(*/.env*)",
      "write_file(*.env*)",
      "write_file(.env*)",
      "write_file(*/.env*)"
    ]
  }
}
