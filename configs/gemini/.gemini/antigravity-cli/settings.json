    "ask": [
      "command(*.env*)",
      "command(brew install *)",
      "command(chmod 0 *)",
      "command(chmod 000 *)",
      "command(chmod -R *)",
      "command(chown *)",
      "command(curl * --data*)",
      "command(curl * --form*)",
      "command(curl * --json*)",
      "command(curl * --output*)",
      "command(curl * --remote-name*)",
      "command(curl * --request*)",
      "command(curl * --upload-file*)",
      "command(curl * -F*)",
      "command(curl * -O*)",
      "command(curl * -T*)",
      "command(curl * -X*)",
      "command(curl * -d*)",
      "command(curl * -o*)",
      "command(dd *)",
      "command(git checkout -- *)",
      "command(git clean -f*)",
      "command(git push -f*)",
      "command(git push --force*)",
      "command(git reset --hard*)",
      "command(git restore *)",
      "command(halt*)",
