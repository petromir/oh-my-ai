{
  "agentMode": "accept-edits",
  "colorScheme": "colorblind-friendly light",
  "enableTelemetry": false,
  "model": "Gemini 3.6 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(./mvnw clean compile*)",
      "command(./mvnw clean test*)",
      "command(./mvnw clean test-compile*)",
      "command(./mvnw dependency:build-classpath*)",
      "command(./mvnw dependency:tree*)",
      "command(./mvnw -DskipTests dependency:tree*)",
      "command(./mvnw -q clean test*)",
      "command(./mvnw -q clean test-compile*)",
      "command(./mvnw -q dependency:tree*)",
      "command(./mvnw -q -DskipTests dependency:tree*)",
      "command(bash -n*)",
      "command(cat*)",
      "command(curl *)",
      "command(find*)",
      "command(git branch*)",
      "command(git config --get*)",
      "command(git config user.*)",
      "command(git diff*)",
      "command(git log*)",
      "command(git ls-files*)",
      "command(git remote*)",
      "command(git status*)",
      "command(grep*)",
      "command(head*)",
      "command(javap *)",
      "command(jq *)",
      "command(ls*)",
      "command(mkdir*)",
      "command(mvn dependency:get*)",
      "command(shellcheck*)",
      "command(sort*)",
      "command(tail*)",
      "command(tree*)",
      "command(unzip -l*)",
      "command(which *)",
      "command(xmllint --format*)",
      "command(xmllint --noout*)"
