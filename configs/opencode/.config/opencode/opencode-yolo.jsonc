{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "provider": {
    "unsloth-mlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Unsloth MLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "unsloth/Ornith-1.5-9B-MLX": {
          "name": "Ornith-1.5-9B-MLX"
        }
      }
    },
    "opencode-go": {
      "options": {
        "setCacheKey": true
      }
    },
    "cline-pass": {
      "options": {
        "setCacheKey": true
      }
    },
    "google": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "instructions": [
    "./prompts/task-artifact-gate.md",
    "./prompts/tool-routing.md",
    "./prompts/hard-guardrails.md"
  ],
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ]
    }
  },
  "model": "opencode-go/glm-5.3",
  "small_model": "google/gemini-3.8-flash",
  "lsp": true,
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "~/.m2": "allow"
    },
    "doom_loop": "deny",
    "read": {
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "glob": {
      "*": "allow"
    },
    "edit": {
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      "*/.env*": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "bash": {
      "ssh *": "deny",
      "scp *": "deny",
      "npm publish *": "deny",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.jks*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "deny",
      "*": "allow",
      "git push *": "deny",
      "git commit *": "deny"
    }
  },
  "default_agent": "general",
  "agent": {
    "general": {
      "description": "Cost-conscious primary orchestrator for normal use and specialist handoffs",
      "model": "opencode-go/glm-5.3",
      "mode": "primary",
      "variant": "medium",
      "permission": {
        "task": {
          "*": "deny",
          "plan": "allow",
          "explore": "allow",
          "researcher": "allow",
          "executor": "allow",
          "build": "allow",
          "simplifier": "allow",
          "reviewer": "allow",
          "expert-reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/general-guideline.md}",
      "steps": 100
    },
    "build": {
      "description": "Implementation agent reserved for non-trivial coding",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "all",
      "hidden": false,
      "variant": "high",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow",
          "reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/coding-guideline.md}",
      "steps": 100
    },
    "plan": {
      "description": "Research and structured implementation planning subagent",
      "model": "opencode-go/kimi-k3",
      "mode": "all",
      "hidden": false,
      "variant": "medium",
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/planning-guideline.md}",
      "steps": 100
    },
    "explore": {
      "description": "Semantic codebase exploration",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "all",
      "hidden": false,
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}",
      "steps": 100
    },
    "researcher": {
      "description": "Read-only research subagent for evidence gathering, option comparison, and sourced recommendations",
      "model": "opencode-go/kimi-k3",
      "mode": "all",
      "variant": "medium",
      "hidden": false,
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/researcher-guideline.md}",
      "steps": 100
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "google/gemini-3.8-flash",
      "mode": "all",
      "hidden": false,
      "variant": "high",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/executor-guideline.md}"
    },
    "simplifier": {
      "description": "Review changed code for reuse, quality, and efficiency, then fix worthwhile issues",
      "model": "cline-pass/kimi-k3",
      "variant": "medium",
      "mode": "all",
      "hidden": false,
      "permission": {
        "task": {
          "*": "deny",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/simplify-guideline.md}",
      "steps": 100
    },
    "reviewer": {
      "description": "Automated risk-adaptive multi-pass code review agent",
      "model": "cline-pass/qwen3.8-max",
      "variant": "high",
      "mode": "all",
      "hidden": false,
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./prompts/code-review-guideline.md}",
      "steps": 100
    },
    "expert-reviewer": {
      "description": "In-depth final review with premium model",
      "model": "opencode-go/kimi-k3",
      "variant": "high",
      "mode": "all",
      "hidden": false,
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/expert-reviewer-guideline.md}",
      "steps": 100
    }
  }
}