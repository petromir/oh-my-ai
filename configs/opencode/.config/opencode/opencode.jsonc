{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "unsloth-mlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Unsloth MLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "unsloth/Ornith-1.5-9B-MLX": {
          "name": "Ornith-1.5-9B-MLX"
        }
      }
    },
    "opencode-go": {
      "options": {
        "setCacheKey": true
      }
    },
    "cline-pass": {
      "options": {
        "setCacheKey": true
      }
    },
    "google": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "model": "opencode-go/glm-5.2",
  "small_model": "opencode-go/qwen3.7-max",
  "lsp": true,
  "instructions": [
    "./prompts/task-artifact-gate.md",
    "./prompts/tool-routing.md"
  ],
  "mcp": {
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ]
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
      "~/agent-vault": "allow",
      "~/agent-vault/*": "allow",
      "~/.m2": "allow"
    },
    "read": {
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "ask",
      "*/.env*": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "glob": {
      "*": "allow"
    },
    "edit": {
      "~/.aws/*": "deny",
      "~/.azure/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.kube/*": "deny",
      "~/.docker/*": "deny",
      "~/.config/gcloud/*": "deny",
      ".env*": "ask",
      "*/.env*": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "echo * > *": "ask",
      "echo * >> *": "ask",
      "echo * | sh*": "ask",
      "echo * | bash*": "ask",
      "echo *": "allow",
      "mkdir*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "nl*": "allow",
      "find*": "allow",
      "sort*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "bash -n*": "allow",
      "shellcheck*": "allow",
      "tree*": "allow",
      "which *": "allow",
      "javap *": "allow",
      "unzip -l*": "allow",
      "xmllint --noout*": "allow",
      "xmllint --format*": "allow",
      "curl *": "allow",
      "curl * -X*": "ask",
      "curl * --request*": "ask",
      "curl * -d*": "ask",
      "curl * --data*": "ask",
      "curl * -F*": "ask",
      "curl * --form*": "ask",
      "curl * -T*": "ask",
      "curl * --upload-file*": "ask",
      "curl * --json*": "ask",
      "curl * -o*": "ask",
      "curl * --output*": "ask",
      "curl * -O*": "ask",
      "curl * --remote-name*": "ask",
      "jq *": "allow",
      "jq *>*": "ask",
      "wget *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "brew install *": "ask",
      "npm publish *": "ask",
      "*.env*": "ask",
      "*.pem*": "deny",
      "*.key*": "deny",
      "*.p12*": "deny",
      "*.jks*": "deny",
      "*/.ssh/*": "deny",
      "*/.gnupg/*": "deny",
      "*/.aws/*": "deny",
      "*/.azure/*": "deny",
      "*/.kube/*": "deny",
      "*/.docker/*": "deny",
      "*/.config/gcloud/*": "deny",
      "rm *": "ask",
      "sudo rm *": "ask",
      "chmod -R *": "ask",
      "chmod 000 *": "ask",
      "chmod 0 *": "ask",
      "chown *": "ask",
      "sudo chown *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "halt*": "ask",
      "poweroff*": "ask",
      "init 0*": "ask",
      "init 6*": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "kill -9 *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git diff*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git config user.*": "allow",
      "git config --get*": "allow",
      "./mvnw clean test*": "allow",
      "./mvnw -q clean test*": "allow",
      "./mvnw clean compile*": "allow",
      "./mvnw clean test-compile*": "allow",
      "./mvnw -q clean test-compile*": "allow",
      "./mvnw dependency:tree*": "allow",
      "./mvnw -q dependency:tree*": "allow",
      "./mvnw -DskipTests dependency:tree*": "allow",
      "./mvnw -q -DskipTests dependency:tree*": "allow",
      "./mvnw dependency:build-classpath*": "allow",
      "./mvnw dependency:get*": "allow"
    }
  },
  "default_agent": "general",
  "agent": {
    "general": {
      "description": "Cost-conscious primary orchestrator for normal use and specialist handoffs",
      "model": "opencode-go/glm-5.3",
      "mode": "primary",
      "variant": "medium",
      "permission": {
        "task": {
          "*": "deny",
          "plan": "allow",
          "explore": "allow",
          "researcher": "allow",
          "executor": "allow",
          "build": "allow",
          "simplifier": "allow",
          "reviewer": "allow",
          "expert-reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/general-guideline.md}"
    },
    "build": {
      "description": "Implementation agent reserved for non-trivial coding",
      "model": "opencode-go/deepseek-v4-pro",
      "mode": "all",
      "variant": "medium",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow",
          "reviewer": "allow"
        }
      },
      "prompt": "{file:./prompts/coding-guideline.md}"
    },
    "plan": {
      "description": "Research and structured implementation planning subagent",
      "model": "opencode-go/kimi-k3",
      "mode": "all",
      "hidden": false,
      "variant": "medium",
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./skills/planning/SKILL.md}"
    },
    "explore": {
      "description": "Semantic codebase exploration",
      "model": "google/qwen3.8-flash",
      "mode": "all",
      "hidden": false,
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/explore-guideline.md}"
    },
    "researcher": {
      "description": "Read-only research subagent for evidence gathering, option comparison, and sourced recommendations",
      "model": "opencode-go/kimi-k3",
      "mode": "all",
      "variant": "medium",
      "hidden": false,
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/researcher-guideline.md}"
    },
    "executor": {
      "description": "Default execution subagent for bash commands, tests, builds, and validation",
      "model": "google/gemini-3.8-flash",
      "mode": "all",
      "hidden": false,
      "variant": "high",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "task": "deny"
      },
      "prompt": "{file:./prompts/executor-guideline.md}"
    },
    "simplifier": {
      "description": "Review changed code for reuse, quality, and efficiency, then fix worthwhile issues",
      "model": "cline-pass/cline-pass/kimi-k3",
      "variant": "medium",
      "mode": "all",
      "hidden": false,
      "permission": {
        "task": {
          "*": "deny",
          "executor": "allow"
        }
      },
      "prompt": "{file:./skills/simplify/SKILL.md}"
    },
    "reviewer": {
      "description": "Automated risk-adaptive multi-pass code review agent",
      "model": "cline-pass/cline-pass/qwen3.8-max",
      "variant": "high",
      "mode": "all",
      "hidden": false,
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": "deny"
      },
      "prompt": "{file:./skills/code-review/SKILL.md}"
    },
    "expert-reviewer": {
      "description": "In-depth final review with premium model",
      "model": "opencode-go/kimi-k3",
      "variant": "high",
      "mode": "all",
      "hidden": false,
      "permission": {
        "edit": {
          "*": "deny",
          "~/agent-vault": "allow",
          "~/agent-vault/*": "allow"
        },
        "task": {
          "*": "deny",
          "executor": "allow"
        }
      },
      "prompt": "{file:./prompts/expert-reviewer-guideline.md}"
    }
  }
}
